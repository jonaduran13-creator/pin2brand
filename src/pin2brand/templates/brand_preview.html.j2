  </main>

  <div class="toast" id="toast">¡Copiado!</div>
  <script>
    const manifestData = {{ manifest_json | safe }};
    const payloadVersions = {{ payload_versions_json | safe }};
    let activePayloadKey = 'visual-identity.json';
    let isGenericMode = false;

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 1800);
    }

    function copyText(val) {
      navigator.clipboard.writeText(val);
      showToast('Copiado: ' + val.slice(0, 42));
    }

    function switchSimTab(tabId, btnEl) {
      document.querySelectorAll('.sim-panel').forEach(p => p.classList.remove('active'));
      document.getElementById('sim-' + tabId).classList.add('active');
      btnEl.parentElement.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btnEl.classList.add('active');
    }

    function selectPayloadTab(key, btnEl) {
      activePayloadKey = key;
      document.getElementById('current-payload-label').textContent = 'Archivo activo: ' + key;
      const content = (key === 'visual-identity.json')
        ? JSON.stringify(manifestData, null, 2)
        : (payloadVersions[key] || '');
      document.getElementById('payload-viewer').textContent = content;
      if (btnEl) {
        btnEl.parentElement.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        btnEl.classList.add('active');
      }
    }

    function copyCurrentPayload() {
      const txt = document.getElementById('payload-viewer').textContent;
      copyText(txt);
    }

    function downloadCurrentPayload() {
      const txt = document.getElementById('payload-viewer').textContent;
      const blob = new Blob([txt], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = activePayloadKey;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Descargado: ' + activePayloadKey);
    }

    function updateColorToken(cssVar, jsonKey, newHex) {
      const upperHex = newHex.toUpperCase();
      document.documentElement.style.setProperty(cssVar, upperHex);
      document.getElementById('swatch-bg-' + jsonKey).style.background = upperHex;
      document.getElementById('swatch-hex-' + jsonKey).textContent = upperHex;
      if (manifestData.color_system && manifestData.color_system[jsonKey]) {
        manifestData.color_system[jsonKey].hex = upperHex;
      }
      if (activePayloadKey === 'visual-identity.json') {
        document.getElementById('payload-viewer').textContent = JSON.stringify(manifestData, null, 2);
      }
    }

    function toggleCompareMode() {
      isGenericMode = !isGenericMode;
      document.body.classList.toggle('generic-saas-mode', isGenericMode);
      const pill = document.getElementById('mode-pill');
      const btn = document.getElementById('compare-btn');
      if (isGenericMode) {
        pill.textContent = 'MODO ANTES: IA Genérica (Indigo SaaS)';
        btn.textContent = 'Restaurar Identidad Pin2Brand';
      } else {
        pill.textContent = manifestData.frontend_ui_rules.aesthetic_archetype;
        btn.textContent = 'Switch Global Theme: Generic AI vs Pin2Brand';
      }
    }

    function exportUpdatedJson() {
      const blob = new Blob([JSON.stringify(manifestData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'visual-identity.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast('Descargado visual-identity.json');
    }

    // Auto-crop each pin thumbnail from contact_sheet.jpg onto its canvas (works both locally and on GitHub Pages!)
    function hydratePinCanvasesFromContactSheet() {
      const csImg = document.getElementById('master-contact-sheet');
      if (!csImg || !csImg.complete || csImg.naturalWidth === 0) return;

      const cols = 4;
      const marginX = 36, gapX = 24, gapY = 22, topY = 171;
      const cellW = 364, cellH = 345, thumbH = 297;

      function drawCellToCanvas(pinIndex, canvas) {
        const r = Math.floor(pinIndex / cols);
        const c = pinIndex % cols;
        const sx = marginX + c * (cellW + gapX) + 2;
        const sy = topY + r * (cellH + gapY) + 2;
        const sw = cellW - 4;
        const sh = thumbH - 4;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(csImg, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);
      }

      const heroCanvas = document.getElementById('hero-pin-canvas');
      if (heroCanvas) drawCellToCanvas(0, heroCanvas);

      document.querySelectorAll('.pin-crop-canvas').forEach(cv => {
        const idx = parseInt(cv.getAttribute('data-pin-index') || '0', 10);
        drawCellToCanvas(idx, cv);
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      selectPayloadTab('visual-identity.json', null);
      const csImg = document.getElementById('master-contact-sheet');
      if (csImg.complete) {
        hydratePinCanvasesFromContactSheet();
      } else {
        csImg.addEventListener('load', hydratePinCanvasesFromContactSheet);
      }
    });
  </script>
</body>
</html>
