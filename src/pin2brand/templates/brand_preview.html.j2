<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ manifest.project_name }} — Pin2Brand Visual Identity & Language Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="{{ manifest.typography.google_fonts_import_url }}" rel="stylesheet" />
  <style>
{{ tokens_css | safe }}

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background-color: var(--brand-bg-primary);
      color: var(--brand-text-primary);
      font-family: var(--brand-font-body);
      line-height: 1.55;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    body.generic-saas-mode {
      --brand-bg-primary: #F8FAFC;
      --brand-bg-primary-contrast: #0F172A;
      --brand-bg-secondary: #1E1B4B;
      --brand-bg-secondary-contrast: #F8FAFC;
      --brand-surface-card: #FFFFFF;
      --brand-surface-card-contrast: #0F172A;
      --brand-text-primary: #0F172A;
      --brand-text-secondary: #64748B;
      --brand-accent-primary: #6366F1;
      --brand-accent-primary-contrast: #FFFFFF;
      --brand-accent-secondary: #EEF2FF;
      --brand-accent-secondary-contrast: #4338CA;
      --brand-font-display: system-ui, -apple-system, sans-serif;
      --brand-font-heading: system-ui, -apple-system, sans-serif;
      --brand-font-body: system-ui, -apple-system, sans-serif;
      --brand-font-mono: monospace;
      --brand-radius-sm: 8px;
      --brand-radius-md: 12px;
      --brand-radius-lg: 16px;
      --brand-radius-pill: 9999px;
      --brand-border: 1px solid #E2E8F0;
      --brand-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.15);
    }
    .container { max-width: 1260px; margin: 0 auto; padding: 28px 24px 84px; }
    .topbar {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
      padding: 16px 24px;
      background: var(--brand-bg-primary);
      border-bottom: var(--brand-border);
      position: sticky; top: 0; z-index: 30;
    }
    .brand-mark {
      font-family: var(--brand-font-display);
      font-size: 1.45rem;
      letter-spacing: {{ manifest.typography.display_heading.letter_spacing }};
      text-transform: {{ manifest.typography.display_heading.text_transform }};
    }
    .pill {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--brand-font-mono);
      font-size: 0.73rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 5px 11px;
      border-radius: var(--brand-radius-pill);
      background: var(--brand-accent-secondary);
      color: var(--brand-accent-secondary-contrast);
      border: var(--brand-border);
    }
    .pill-accent {
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
    }
    .btn {
      display: inline-block;
      font-family: var(--brand-font-mono);
      font-weight: 700;
      font-size: 0.8rem;
      text-transform: uppercase;
      padding: 10px 16px;
      border-radius: var(--brand-radius-md);
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
      border: var(--brand-border);
      box-shadow: var(--brand-shadow);
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.12s ease;
    }
    .btn:hover { transform: translate(-2px, -2px); }
    .btn-secondary {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
    }
    .section { margin-top: 52px; }
    .section-header {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end;
      gap: 12px; margin-bottom: 18px; padding-bottom: 10px; border-bottom: var(--brand-border);
    }
    .section-title {
      font-family: var(--brand-font-heading);
      font-size: 1.9rem;
      letter-spacing: {{ manifest.typography.section_heading.letter_spacing }};
      text-transform: {{ manifest.typography.section_heading.text_transform }};
      margin: 0;
    }
    .section-subtitle {
      font-size: 0.92rem; color: var(--brand-text-secondary); margin: 0;
    }

    /* Hero Card */
    .hero-card {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-lg);
      box-shadow: var(--brand-shadow);
      padding: 36px;
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 28px;
      align-items: center;
      position: relative;
      overflow: hidden;
    }
    @media (max-width: 860px) { .hero-card { grid-template-columns: 1fr; } }
    .hero-h1 {
      font-family: var(--brand-font-display);
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      line-height: 0.98;
      letter-spacing: {{ manifest.typography.display_heading.letter_spacing }};
      text-transform: {{ manifest.typography.display_heading.text_transform }};
      margin: 12px 0 14px;
    }
    .extraction-badges {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin-top: 20px;
    }
    .stat-box {
      background: var(--brand-bg-primary);
      color: var(--brand-text-primary);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      padding: 12px 14px;
    }
    .stat-box small {
      display: block; font-family: var(--brand-font-mono); font-size: 0.7rem;
      text-transform: uppercase; color: var(--brand-text-secondary);
    }
    .stat-box strong {
      font-family: var(--brand-font-heading); font-size: 1.15rem; letter-spacing: 0.02em;
    }

    /* Texture & Pattern Lab */
    .texture-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(275px, 1fr));
      gap: 20px;
    }
    .texture-card {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .texture-preview {
      height: 155px;
      position: relative;
      display: flex;
      align-items: flex-end;
      padding: 12px;
      border-bottom: var(--brand-border);
    }
    .tex-mineral {
      background-color: var(--brand-bg-secondary);
      background-image:
        radial-gradient(circle at 20% 30%, rgba(155, 55, 33, 0.24) 0%, transparent 55%),
        radial-gradient(circle at 80% 70%, rgba(49, 41, 42, 0.35) 0%, transparent 60%);
    }
    .tex-blockprint {
      background-color: var(--brand-bg-primary);
      background-image:
        radial-gradient(var(--brand-accent-primary) 2.2px, transparent 2.2px),
        radial-gradient(var(--brand-accent-secondary) 2px, var(--brand-bg-primary) 2px);
      background-size: 20px 20px;
      background-position: 0 0, 10px 10px;
    }
    .tex-stripes {
      background: repeating-linear-gradient(
        -45deg,
        var(--brand-accent-primary),
        var(--brand-accent-primary) 14px,
        var(--brand-bg-secondary) 14px,
        var(--brand-bg-secondary) 28px,
        var(--brand-accent-secondary) 28px,
        var(--brand-accent-secondary) 42px
      );
    }
    .tex-geometry {
      background: var(--brand-bg-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
    }
    .geo-chip {
      padding: 12px 16px;
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
      border: var(--brand-border);
      box-shadow: var(--brand-shadow);
      font-family: var(--brand-font-mono);
      font-size: 0.76rem;
      font-weight: 700;
    }
    .texture-body { padding: 16px; flex: 1; }
    .texture-body h3 {
      margin: 0 0 8px;
      font-family: var(--brand-font-heading);
      font-size: 1.25rem;
      letter-spacing: 0.03em;
    }
    .texture-body p { margin: 0; font-size: 0.88rem; color: var(--brand-text-secondary); }

    /* Pin-by-Pin Visual Autopsy */
    .pins-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
    }
    .pin-card {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .pin-media {
      position: relative;
      width: 100%;
      height: 210px;
      background: #18181A;
      border-bottom: var(--brand-border);
      overflow: hidden;
    }
    .pin-media img, .pin-media canvas {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .pin-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: #111111;
      color: #FAF8F5;
      border: 2px solid #FAF8F5;
      border-radius: 6px;
      padding: 2px 9px;
      font-family: var(--brand-font-mono);
      font-weight: 700;
      font-size: 0.78rem;
    }
    .pin-swatches {
      display: flex;
      border-bottom: var(--brand-border);
    }
    .pin-swatch-item {
      flex: 1;
      padding: 6px 4px;
      text-align: center;
      font-family: var(--brand-font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      cursor: pointer;
      color: #FFFFFF;
      text-shadow: 0 1px 2px rgba(0,0,0,0.85);
    }
    .pin-info { padding: 14px; flex: 1; display: flex; flex-direction: column; gap: 8px; }
    .pin-tags { display: flex; flex-wrap: wrap; gap: 5px; }
    .pin-tag {
      font-family: var(--brand-font-mono);
      font-size: 0.67rem;
      padding: 2px 7px;
      border-radius: var(--brand-radius-sm);
      background: var(--brand-bg-primary);
      color: var(--brand-text-primary);
      border: 1px solid var(--brand-text-secondary);
    }

    /* Multi-Version Simulator Tabs */
    .tab-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }
    .tab-btn {
      font-family: var(--brand-font-mono);
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 10px 16px;
      border-radius: var(--brand-radius-md);
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      cursor: pointer;
    }
    .tab-btn.active {
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
      box-shadow: var(--brand-shadow);
    }
    .sim-panel { display: none; }
    .sim-panel.active { display: block; }

    /* Version 1: Web Storefront Mockup */
    .mockup-frame {
      background: var(--brand-bg-primary);
      color: var(--brand-text-primary);
      border: var(--brand-border);
      border-radius: var(--brand-radius-lg);
      box-shadow: var(--brand-shadow);
      overflow: hidden;
    }
    .mockup-nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 14px 24px; background: var(--brand-surface-card); border-bottom: var(--brand-border);
    }
    .mockup-body { padding: 28px; }
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 18px;
      margin-top: 22px;
    }
    .menu-item {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      padding: 18px;
    }

    /* Version 2: Mobile App & Stamp Card */
    .mobile-showcase {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 24px;
      align-items: start;
    }
    .phone-frame {
      max-width: 370px;
      margin: 0 auto;
      background: var(--brand-bg-primary);
      border: 3px solid var(--brand-text-primary);
      border-radius: 28px;
      box-shadow: var(--brand-shadow);
      padding: 20px;
    }
    .stamp-row {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 8px;
      margin: 14px 0;
    }
    .stamp-circle {
      aspect-ratio: 1;
      border-radius: 50%;
      border: var(--brand-border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--brand-font-mono);
      font-weight: 700;
      font-size: 0.85rem;
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
    }

    /* Version 3: Branding Poster & Receipt Ticket */
    .branding-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 24px;
    }
    .poster-card {
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      padding: 32px 24px;
      text-align: center;
      position: relative;
    }
    .receipt-ticket {
      background: var(--brand-bg-secondary);
      color: var(--brand-bg-secondary-contrast);
      border: 2px dashed var(--brand-bg-secondary-contrast);
      border-radius: var(--brand-radius-sm);
      padding: 24px;
      font-family: var(--brand-font-mono);
    }

    /* Version 4: Side-by-Side Before vs After */
    .split-compare {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    @media (max-width: 820px) { .split-compare { grid-template-columns: 1fr; } }
    .generic-box {
      background: #F8FAFC;
      color: #0F172A;
      border: 1px solid #E2E8F0;
      border-radius: 14px;
      box-shadow: 0 10px 20px -5px rgba(99, 102, 241, 0.15);
      padding: 26px;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .generic-btn {
      background: linear-gradient(135deg, #6366F1, #8B5CF6);
      color: #FFFFFF;
      border: none;
      border-radius: 10px;
      padding: 10px 18px;
      font-weight: 600;
      font-size: 0.88rem;
    }

    /* Color Swatches */
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 16px;
    }
    .swatch-card {
      background: var(--brand-surface-card);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      overflow: hidden;
    }
    .swatch-color {
      height: 92px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 10px;
    }
    .swatch-hex {
      font-family: var(--brand-font-mono);
      font-weight: 700;
      font-size: 0.84rem;
      padding: 3px 8px;
      border-radius: var(--brand-radius-sm);
      background: rgba(0, 0, 0, 0.6);
      color: #FFFFFF;
      cursor: pointer;
    }
    .color-picker-input {
      width: 28px; height: 28px; border: none; padding: 0; background: transparent; cursor: pointer;
    }
    .swatch-meta { padding: 12px; font-size: 0.84rem; }
    .swatch-meta strong { display: block; margin-bottom: 4px; }

    /* Rules & Anti-patterns 2-col */
    .rules-two-col {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 20px;
      margin-top: 22px;
    }
    @media (max-width: 860px) { .rules-two-col { grid-template-columns: 1fr; } }
    .ui-card {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      padding: 22px;
    }
    .code-explorer {
      background: #141210;
      color: #F6F2EA;
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      padding: 20px;
    }
    .code-pre {
      font-family: var(--brand-font-mono);
      font-size: 0.8rem;
      background: #1E1B18;
      color: #F6F2EA;
      border: 1px solid #3D3530;
      border-radius: var(--brand-radius-sm);
      padding: 16px;
      max-height: 440px;
      overflow: auto;
      white-space: pre-wrap;
      margin-top: 12px;
    }
    .contact-img {
      width: 100%;
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      display: block;
    }
    .toast {
      position: fixed; bottom: 24px; right: 24px;
      background: var(--brand-accent-primary); color: var(--brand-accent-primary-contrast);
      border: var(--brand-border);
      box-shadow: var(--brand-shadow);
      padding: 12px 18px; border-radius: var(--brand-radius-sm);
      font-family: var(--brand-font-mono); font-size: 0.84rem; font-weight: 700;
      opacity: 0; pointer-events: none; transition: opacity 0.2s; z-index: 100;
    }
    .toast.show { opacity: 1; }
  </style>
</head>
<body>
  <!-- Hidden SVG Fractal Noise Filter for Organic Mineral/Paper Grain -->
  <svg width="0" height="0" style="position:absolute;">
    <filter id="pin2brand-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.14" />
      </feComponentTransfer>
      <feBlend in="SourceGraphic" mode="multiply" />
    </filter>
  </svg>

  <header class="topbar">
    <div class="brand-mark">{{ manifest.project_name }}</div>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <span class="pill" id="mode-pill">{{ manifest.frontend_ui_rules.aesthetic_archetype }}</span>
      <button class="btn btn-secondary" onclick="toggleCompareMode()" id="compare-btn">Switch Global Theme: Generic AI vs Pin2Brand</button>
      <button class="btn" onclick="exportUpdatedJson()">Download visual-identity.json</button>
    </div>
  </header>

  <main class="container">
    <!-- HERO -->
    <section class="hero-card">
      <div>
        <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
          <span class="pill pill-accent">Pin2Brand Visual Compiler</span>
          <span class="pill">{{ manifest.reference_pins | length }} Pines Analizados</span>
        </div>
        <h1 class="hero-h1">{{ manifest.project_name }}</h1>
        <p style="font-size:1.02rem;">{{ manifest.brand_essence_summary }}</p>

        <div style="display:flex; gap:7px; flex-wrap:wrap; margin: 14px 0;">
          {% for kw in manifest.mood_keywords %}
          <span class="pill" style="font-size:0.68rem;">#{{ kw }}</span>
          {% endfor %}
        </div>

        <div class="extraction-badges">
          <div class="stat-box">
            <small>1. Ciencia de Color</small>
            <strong>CIELAB + ΔE00</strong>
          </div>
          <div class="stat-box">
            <small>2. Física de Superficie</small>
            <strong>Grano Laplaciano 2D</strong>
          </div>
          <div class="stat-box">
            <small>3. Tipografía & UI</small>
            <strong>{{ manifest.typography.display_heading.family_recommended }}</strong>
          </div>
          <div class="stat-box">
            <small>4. Kits Multi-Agente</small>
            <strong>9 Formatos Listos</strong>
          </div>
        </div>
      </div>
      <div>
        <canvas id="hero-pin-canvas" width="360" height="293" style="width:100%; border-radius: var(--brand-radius-md); border: var(--brand-border); box-shadow: var(--brand-shadow); display:block;"></canvas>
        <div style="margin-top:8px; font-family:var(--brand-font-mono); font-size:0.74rem; color:var(--brand-text-secondary); text-align:center;">
          Referencia Líder #1 + Textura y Paleta Extraídas del Tablero
        </div>
      </div>
    </section>

    <!-- SECTION 1: VISUAL LANGUAGE, TEXTURES & PATTERNS LAB -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2 class="section-title">1. Lenguaje Visual, Texturas, Patrones y Geometría</h2>
          <p class="section-subtitle">Lo que Pin2Brand deduce más allá del color: materialidad física, patrones gráficos, bordes, sombras y reglas de componentes.</p>
        </div>
        <span class="pill">Materiality & Design Grammar</span>
      </div>

      <div class="texture-grid">
        <div class="texture-card">
          <div class="texture-preview tex-mineral">
            <span class="pill">Superficie & Materialidad</span>
          </div>
          <div class="texture-body">
            <h3>Grano Mineral & Textura Orgánica</h3>
            <p>{{ manifest.frontend_ui_rules.texture_and_effects[0] if manifest.frontend_ui_rules.texture_and_effects else "Superficie táctil con grano analógico y contraste cálido." }}</p>
          </div>
        </div>

        <div class="texture-card">
          <div class="texture-preview tex-blockprint">
            <span class="pill pill-accent">Patrón Gráfico / Motif</span>
          </div>
          <div class="texture-body">
            <h3>Trama y Motivos Gráficos del Tablero</h3>
            <p>{{ manifest.frontend_ui_rules.texture_and_effects[1] if manifest.frontend_ui_rules.texture_and_effects | length > 1 else "Contraste de pigmentos y motivos gráficos repetibles extraídos de los pines." }}</p>
          </div>
        </div>

        <div class="texture-card">
          <div class="texture-preview tex-stripes">
            <span class="pill">Ritmo Cromático & Empaque</span>
          </div>
          <div class="texture-body">
            <h3>Contraste {{ manifest.color_system.accent_primary.hex }} / {{ manifest.color_system.accent_secondary.hex }} / {{ manifest.color_system.background_secondary.hex }}</h3>
            <p>{{ manifest.color_system.color_harmony_notes }}</p>
          </div>
        </div>

        <div class="texture-card">
          <div class="texture-preview tex-geometry">
            <div class="geo-chip" style="border-radius: var(--brand-radius-sm);">r={{ manifest.frontend_ui_rules.border_radius_tokens.sm }}</div>
            <div class="geo-chip" style="border-radius: var(--brand-radius-md); background:var(--brand-accent-secondary); color:var(--brand-accent-secondary-contrast);">r={{ manifest.frontend_ui_rules.border_radius_tokens.md }}</div>
