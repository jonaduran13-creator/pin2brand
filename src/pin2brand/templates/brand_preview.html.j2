          <button class="tab-btn" onclick="selectPayloadTab('AGENTS.md', this)">AGENTS.md</button>
          <button class="tab-btn" onclick="selectPayloadTab('cursor-visual-identity.mdc', this)">cursor-rules.mdc</button>
          <button class="tab-btn" onclick="selectPayloadTab('SKILL.md', this)">SKILL.md</button>
