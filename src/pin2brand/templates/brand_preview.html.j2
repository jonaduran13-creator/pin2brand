<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ manifest.project_name }} — Pin2Brand Interactive Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="{{ manifest.typography.google_fonts_import_url }}" rel="stylesheet" />
  <style>
{{ tokens_css }}

    * { box-sizing: border-box; }
    body {
      margin: 0;
      background-color: var(--brand-bg-primary);
      color: var(--brand-text-primary);
      font-family: var(--brand-font-body);
      line-height: 1.55;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    /* Generic SaaS Before-mode override for interactive comparison */
    body.generic-saas-mode {
      --brand-bg-primary: #F8FAFC;
      --brand-bg-primary-contrast: #0F172A;
      --brand-bg-secondary: #1E1B4B;
      --brand-bg-secondary-contrast: #F8FAFC;
      --brand-surface-card: #FFFFFF;
      --brand-surface-card-contrast: #0F172A;
      --brand-text-primary: #0F172A;
      --brand-text-secondary: #64748B;
      --brand-accent-primary: #6366F1;
      --brand-accent-primary-contrast: #FFFFFF;
      --brand-accent-secondary: #EEF2FF;
      --brand-accent-secondary-contrast: #4338CA;
      --brand-font-display: system-ui, -apple-system, sans-serif;
      --brand-font-heading: system-ui, -apple-system, sans-serif;
      --brand-font-body: system-ui, -apple-system, sans-serif;
      --brand-font-mono: monospace;
      --brand-radius-sm: 8px;
      --brand-radius-md: 12px;
      --brand-radius-lg: 16px;
      --brand-radius-pill: 9999px;
      --brand-border: 1px solid #E2E8F0;
      --brand-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.15);
    }
    .container { max-width: 1220px; margin: 0 auto; padding: 28px 24px 72px; }
    .topbar {
      display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px;
      padding: 16px 24px;
      background: var(--brand-bg-primary);
      border-bottom: var(--brand-border);
      position: sticky; top: 0; z-index: 20;
    }
    .brand-mark {
      font-family: var(--brand-font-display);
      font-size: 1.4rem;
      letter-spacing: {{ manifest.typography.display_heading.letter_spacing }};
      text-transform: {{ manifest.typography.display_heading.text_transform }};
    }
    .pill {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--brand-font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 6px 12px;
      border-radius: var(--brand-radius-pill);
      background: var(--brand-accent-secondary);
      color: var(--brand-accent-secondary-contrast);
      border: var(--brand-border);
    }
    .btn {
      display: inline-block;
      font-family: var(--brand-font-mono);
      font-weight: 700;
      font-size: 0.82rem;
      text-transform: uppercase;
      padding: 11px 18px;
      border-radius: var(--brand-radius-md);
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
      border: var(--brand-border);
      box-shadow: var(--brand-shadow);
      cursor: pointer;
      text-decoration: none;
      transition: transform 0.12s ease;
    }
    .btn:hover { transform: translate(-2px, -2px); }
    .btn-secondary {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
    }
    .section { margin-top: 44px; }
    .section-title {
      font-family: var(--brand-font-heading);
      font-size: 1.8rem;
      letter-spacing: {{ manifest.typography.section_heading.letter_spacing }};
      text-transform: {{ manifest.typography.section_heading.text_transform }};
      margin: 0 0 16px;
      padding-bottom: 8px;
      border-bottom: var(--brand-border);
    }
    .hero-card {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-lg);
      box-shadow: var(--brand-shadow);
      padding: 36px;
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 28px;
      align-items: center;
    }
    @media (max-width: 820px) { .hero-card { grid-template-columns: 1fr; } }
    .hero-h1 {
      font-family: var(--brand-font-display);
      font-size: clamp(2.1rem, 4.5vw, 3.6rem);
      line-height: 0.98;
      letter-spacing: {{ manifest.typography.display_heading.letter_spacing }};
      text-transform: {{ manifest.typography.display_heading.text_transform }};
      margin: 12px 0 14px;
    }
    .swatch-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 16px;
    }
    .swatch-card {
      background: var(--brand-surface-card);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      overflow: hidden;
    }
    .swatch-color {
      height: 96px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding: 10px;
    }
    .swatch-hex {
      font-family: var(--brand-font-mono);
      font-weight: 700;
      font-size: 0.85rem;
      padding: 3px 8px;
      border-radius: var(--brand-radius-sm);
      background: rgba(0, 0, 0, 0.55);
      color: #FFFFFF;
      cursor: pointer;
    }
    .color-picker-input {
      width: 28px; height: 28px; border: none; padding: 0; background: transparent; cursor: pointer;
    }
    .swatch-meta { padding: 12px; font-size: 0.85rem; }
    .swatch-meta strong { display: block; margin-bottom: 4px; }
    .card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
    }
    .ui-card {
      background: var(--brand-surface-card);
      color: var(--brand-surface-card-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      padding: 20px;
    }
    .dark-band {
      background: var(--brand-bg-secondary);
      color: var(--brand-bg-secondary-contrast);
      border: var(--brand-border);
      border-radius: var(--brand-radius-lg);
      padding: 28px;
    }
    .prompt-box {
      font-family: var(--brand-font-mono);
      font-size: 0.82rem;
      background: rgba(0, 0, 0, 0.14);
      border: 1px solid rgba(128, 128, 128, 0.35);
      border-radius: var(--brand-radius-sm);
      padding: 14px;
      margin-top: 8px;
      white-space: pre-wrap;
    }
    .copy-btn {
      margin-top: 8px;
      padding: 6px 12px;
      font-family: var(--brand-font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      border-radius: var(--brand-radius-sm);
      background: var(--brand-accent-primary);
      color: var(--brand-accent-primary-contrast);
      border: none;
      cursor: pointer;
    }
    .contact-img {
      width: 100%;
      border: var(--brand-border);
      border-radius: var(--brand-radius-md);
      box-shadow: var(--brand-shadow);
      display: block;
    }
    .toast {
      position: fixed; bottom: 24px; right: 24px;
      background: var(--brand-text-primary); color: var(--brand-bg-primary);
      padding: 10px 16px; border-radius: var(--brand-radius-sm);
      font-family: var(--brand-font-mono); font-size: 0.85rem;
      opacity: 0; pointer-events: none; transition: opacity 0.2s;
    }
    .toast.show { opacity: 1; }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand-mark">{{ manifest.project_name }}</div>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <span class="pill" id="mode-pill">{{ manifest.frontend_ui_rules.aesthetic_archetype }}</span>
      <button class="btn btn-secondary" onclick="toggleCompareMode()" id="compare-btn">Compare: Generic AI vs Pin2Brand</button>
      <button class="btn" onclick="exportUpdatedJson()">Export Updated JSON</button>
    </div>
  </header>

  <main class="container">
    <section class="hero-card">
      <div>
        <span class="pill">Pin2Brand Visual Identity Kit</span>
        <h1 class="hero-h1">{{ manifest.project_name }}</h1>
        <p>{{ manifest.brand_essence_summary }}</p>
        <div style="display:flex; gap:8px; flex-wrap:wrap; margin: 12px 0;">
          {% for kw in manifest.mood_keywords %}
          <span class="pill" style="font-size:0.7rem;">#{{ kw }}</span>
          {% endfor %}
        </div>
        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:18px;">
          <button class="btn" onclick="copyText(manifestData.generative_ai_prompts.global_style_prefix)">Copy Image Prefix</button>
          <a class="btn btn-secondary" href="{{ manifest.board_url }}" target="_blank" rel="noreferrer">Source Pinterest Board</a>
        </div>
      </div>
      <div>
        {% if manifest.reference_pins %}
        <img src="references/pin_01.jpg" alt="Lead Reference" style="width:100%; border-radius: var(--brand-radius-md); border: var(--brand-border); object-fit: cover; max-height: 360px;" />
        {% endif %}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Color System (Click HEX to Copy • Pick Color to Live-Tune)</h2>
      <div class="swatch-grid">
        {% for label, css_var, json_key, tok in color_tokens %}
        <div class="swatch-card">
          <div class="swatch-color" id="swatch-bg-{{ json_key }}" style="background: {{ tok.hex }};">
            <span class="swatch-hex" id="swatch-hex-{{ json_key }}" onclick="copyText(document.getElementById('swatch-hex-{{ json_key }}').textContent)">{{ tok.hex }}</span>
            <input type="color" class="color-picker-input" value="{{ tok.hex }}" title="Tune {{ label }}" oninput="updateColorToken('{{ css_var }}', '{{ json_key }}', this.value)" />
          </div>
          <div class="swatch-meta">
            <strong>{{ label }} — {{ tok.name }}</strong>
            <span style="color: var(--brand-text-secondary);">{{ tok.role }}</span>
          </div>
        </div>
        {% endfor %}
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Live Typography & UI Playground</h2>
      <div class="card-grid">
        <div class="ui-card">
          <span class="pill">Display & Heading</span>
          <div style="font-family: var(--brand-font-display); font-size: 2rem; margin: 12px 0 6px; text-transform: {{ manifest.typography.display_heading.text_transform }};">
            {{ manifest.typography.display_heading.family_recommended }}
          </div>
          <div style="font-family: var(--brand-font-heading); font-size: 1.25rem; color: var(--brand-accent-primary);">
            Section: {{ manifest.typography.section_heading.family_recommended }}
          </div>
          <p style="margin-top:10px; font-size:0.9rem; color: var(--brand-text-secondary);">
            Body ({{ manifest.typography.body_copy.family_recommended }}): {{ manifest.typography.body_copy.styling_notes }}
          </p>
        </div>

        <div class="ui-card">
          <span class="pill">Sample Component Card</span>
          <h3 style="font-family: var(--brand-font-heading); margin: 12px 0 6px;">Signature Product Tile</h3>
          <p style="font-size: 0.92rem; color: var(--brand-text-secondary);">
            Styled with <code>{{ manifest.frontend_ui_rules.border_style }}</code> and shadow <code>{{ manifest.frontend_ui_rules.shadow_style }}</code>.
          </p>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-top:14px;">
            <span style="font-family: var(--brand-font-mono); font-weight:700;">$14.50</span>
            <button class="btn" onclick="copyText(manifestData.color_system.accent_primary.hex)">Order Now</button>
          </div>
        </div>
      </div>
    </section>

    <section class="section dark-band">
      <h2 class="section-title">Generative AI Prompts (Midjourney / Flux / Imagen)</h2>
      <div>
        <strong>Hero Photography Template:</strong>
        <div class="prompt-box" id="p-hero">{{ manifest.generative_ai_prompts.use_case_templates.hero_photography }}</div>
        <button class="copy-btn" onclick="copyById('p-hero')">Copy Hero Prompt</button>
      </div>
      <div style="margin-top:16px;">
        <strong>Mascot / Brand Illustration Template:</strong>
        <div class="prompt-box" id="p-mascot">{{ manifest.generative_ai_prompts.use_case_templates.brand_mascot_illustration }}</div>
        <button class="copy-btn" onclick="copyById('p-mascot')">Copy Illustration Prompt</button>
      </div>
      <div style="margin-top:16px;">
        <strong>Negative Prompt:</strong>
        <div class="prompt-box" id="p-neg">{{ manifest.generative_ai_prompts.negative_prompt }}</div>
        <button class="copy-btn" onclick="copyById('p-neg')">Copy Negative Prompt</button>
      </div>
    </section>

    <section class="section">
      <h2 class="section-title">Board Contact Sheet</h2>
      <img class="contact-img" src="contact_sheet.jpg" alt="Pin2Brand Contact Sheet" />
    </section>
  </main>

  <div class="toast" id="toast">Copied!</div>
  <script>
    const manifestData = {{ manifest_json }};
    let isGenericMode = false;

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 1600);
    }
    function copyText(val) {
      navigator.clipboard.writeText(val);
      showToast('Copied: ' + val.slice(0, 36));
    }
    function copyById(id) {
      const txt = document.getElementById(id).textContent;
      copyText(txt);
    }
    function updateColorToken(cssVar, jsonKey, newHex) {
      const upperHex = newHex.toUpperCase();
      document.documentElement.style.setProperty(cssVar, upperHex);
      document.getElementById('swatch-bg-' + jsonKey).style.background = upperHex;
      document.getElementById('swatch-hex-' + jsonKey).textContent = upperHex;
      if (manifestData.color_system && manifestData.color_system[jsonKey]) {
        manifestData.color_system[jsonKey].hex = upperHex;
      }
    }
    function toggleCompareMode() {
      isGenericMode = !isGenericMode;
      document.body.classList.toggle('generic-saas-mode', isGenericMode);
      const pill = document.getElementById('mode-pill');
      const btn = document.getElementById('compare-btn');
      if (isGenericMode) {
        pill.textContent = 'BEFORE: Generic AI Default (Indigo SaaS)';
        btn.textContent = 'Restore Pin2Brand Identity';
      } else {
        pill.textContent = manifestData.frontend_ui_rules.aesthetic_archetype;
        btn.textContent = 'Compare: Generic AI vs Pin2Brand';
      }
    }
    function exportUpdatedJson() {
      const blob = new Blob([JSON.stringify(manifestData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'visual-identity.json';
      a.click();
      URL.revokeObjectURL(url);
      showToast('Downloaded updated visual-identity.json');
    }
  </script>
</body>
</html>
