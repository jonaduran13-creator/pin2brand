/* Generated by Pin2Brand — {{ manifest.project_name }} */
/* Source Board: {{ manifest.board_url }} */

:root {
  /* Color Tokens */
  --brand-bg-primary: {{ manifest.color_system.background_primary.hex }};
  --brand-bg-primary-contrast: {{ manifest.color_system.background_primary.contrast_text_hex }};
  --brand-bg-secondary: {{ manifest.color_system.background_secondary.hex }};
  --brand-bg-secondary-contrast: {{ manifest.color_system.background_secondary.contrast_text_hex }};
  --brand-surface-card: {{ manifest.color_system.surface_card.hex }};
  --brand-surface-card-contrast: {{ manifest.color_system.surface_card.contrast_text_hex }};

  --brand-text-primary: {{ manifest.color_system.text_primary.hex }};
  --brand-text-secondary: {{ manifest.color_system.text_secondary.hex }};

  --brand-accent-primary: {{ manifest.color_system.accent_primary.hex }};
  --brand-accent-primary-contrast: {{ manifest.color_system.accent_primary.contrast_text_hex }};
  --brand-accent-secondary: {{ manifest.color_system.accent_secondary.hex }};
  --brand-accent-secondary-contrast: {{ manifest.color_system.accent_secondary.contrast_text_hex }};

  --brand-semantic-warning: {{ manifest.color_system.semantic_warning.hex }};
  --brand-semantic-success: {{ manifest.color_system.semantic_success.hex }};

  /* Typography */
  --brand-font-display: '{{ manifest.typography.display_heading.family_recommended }}', serif, sans-serif;
  --brand-font-heading: '{{ manifest.typography.section_heading.family_recommended }}', sans-serif;
  --brand-font-body: '{{ manifest.typography.body_copy.family_recommended }}', system-ui, sans-serif;
  --brand-font-mono: '{{ manifest.typography.monospace_accent.family_recommended }}', monospace;

  /* Geometry, Borders & Elevation */
  --brand-radius-sm: {{ manifest.frontend_ui_rules.border_radius_tokens.sm }};
  --brand-radius-md: {{ manifest.frontend_ui_rules.border_radius_tokens.md }};
  --brand-radius-lg: {{ manifest.frontend_ui_rules.border_radius_tokens.lg }};
  --brand-radius-pill: {{ manifest.frontend_ui_rules.border_radius_tokens.pill }};
  --brand-border: {{ manifest.frontend_ui_rules.border_style }};
  --brand-shadow: {{ manifest.frontend_ui_rules.shadow_style }};
}
