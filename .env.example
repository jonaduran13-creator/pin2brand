# Vision Provider API Keys (All Optional)
# Without any API key, Pin2Brand uses its deterministic CIELAB + Laplacian texture synthesizer.

# Option 1: Google Gemini Vision (Recommended - gemini-2.5-flash)
GEMINI_API_KEY=

# Option 2: OpenAI Vision (gpt-4o / gpt-4.1-mini)
OPENAI_API_KEY=

# Option 3: Local Ollama Vision (100% free & offline - e.g. llama3.2-vision or qwen2.5-vl)
OLLAMA_HOST=http://localhost:11434

# Optional: Pinterest Session Cookie for private/secret boards
PINTEREST_SESSION_COOKIE=
